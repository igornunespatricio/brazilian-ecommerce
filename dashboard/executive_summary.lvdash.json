            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "c605aa4a",
      "displayName": "repeat customer rate",
      "queryLines": [
        "SELECT\r\n",
        "  ROUND(\r\n",
        "    COUNT(CASE WHEN total_orders > 1 THEN 1 END) / COUNT(*),\r\n",
        "    4\r\n",
        "  ) AS repeat_customer_rate\r\n",
        "FROM brazilian_ecommerce.prod.gold_customer_summary"
      ]
    },
