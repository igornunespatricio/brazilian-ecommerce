    {
      "name": "a3ee280b",
      "displayName": "on time delivered pct",
      "queryLines": [
        "SELECT\r\n",
        "  ROUND(\r\n",
        "    COUNT(CASE WHEN delivery_status = 'on_time' THEN 1 END)\r\n",
        "    / COUNT(CASE WHEN delivery_status IS NOT NULL THEN 1 END),\r\n",
        "    4\r\n",
        "  ) AS pct_delivered_on_time\r\n",
        "FROM brazilian_ecommerce.prod.gold_sales_summary"
      ],
      "catalog": "brazilian_ecommerce",
      "schema": "prod"
    },
    {
      "name": "2f4e12ad",
      "displayName": "gold_category_review_scores",
      "config": {
